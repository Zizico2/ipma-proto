set positional-arguments

default:
    @just --list

build:
    cargo build --locked

# Generate Rust bindings in OUT_DIR through build.rs.
generate: build

fmt:
    cargo fmt --all

fmt-check:
    cargo fmt --all --check

check:
    cargo check --locked --all-targets

lint:
    cargo clippy --locked --all-targets -- -D warnings

test:
    cargo test --locked --all-targets
    cargo test --locked --doc

# Extra forecast calls are opt-in; the adapter contacts IPMA each time.
smoke address='http://127.0.0.1:50051' extra_calls='0':
    cargo run --locked --example smoke -- "$1" "$2"

verify: fmt-check check lint test
